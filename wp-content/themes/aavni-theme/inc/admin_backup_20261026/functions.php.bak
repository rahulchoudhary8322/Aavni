<?php
/**
 * AAVNI Luxury Fashion Theme Functions
 *
 * @package AAVNI
 */

if (!defined('ABSPATH')) {
    exit;
}

// 1. Theme Setup & WooCommerce Support
function aavni_theme_setup() {
    add_theme_support('woocommerce');
    add_theme_support('wc-product-gallery-zoom');
    add_theme_support('wc-product-gallery-lightbox');
    add_theme_support('wc-product-gallery-slider');
    add_theme_support('title-tag');
    add_theme_support('post-thumbnails');
    add_theme_support('custom-logo');

    register_nav_menus(array(
        'aavni-primary' => __('AAVNI Primary Navigation', 'aavni'),
        'aavni-footer-collections' => __('AAVNI Footer Collections', 'aavni'),
        'aavni-footer-policies' => __('AAVNI Footer Policies', 'aavni'),
    ));
}
add_action('after_setup_theme', 'aavni_theme_setup');

// 2. Enqueue Styles & Scripts
function aavni_enqueue_assets() {
    // Parent theme style
    wp_enqueue_style('astra-parent-style', get_template_directory_uri() . '/style.css');

    // Google Fonts: Urbanist & Playfair Display
    wp_enqueue_style('aavni-google-fonts', 'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Urbanist:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap', array(), null);

    // Custom Luxury Design System
    wp_enqueue_style('aavni-custom-css', get_stylesheet_directory_uri() . '/assets/css/aavni-custom.css', array('astra-parent-style'), filemtime(get_stylesheet_directory() . '/assets/css/aavni-custom.css'));

    // Custom Interactive Scripts
    wp_enqueue_script('aavni-scripts', get_stylesheet_directory_uri() . '/assets/js/aavni-scripts.js', array('jquery'), filemtime(get_stylesheet_directory() . '/assets/js/aavni-scripts.js'), true);

    // Pass AJAX parameters
    wp_localize_script('aavni-scripts', 'aavni_params', array(
        'ajax_url' => admin_url('admin-ajax.php'),
        'cart_url' => wc_get_cart_url(),
        'checkout_url' => wc_get_checkout_url(),
    ));
}
add_action('wp_enqueue_scripts', 'aavni_enqueue_assets', 20);

// 3. WooCommerce Dynamic AJAX Cart Fragments
function aavni_cart_fragments($fragments) {
    ob_start();
    ?>
    <span class="aavni-badge-count aavni-cart-count">
        <?php echo WC()->cart ? WC()->cart->get_cart_contents_count() : 0; ?>
    </span>
    <?php
    $fragments['span.aavni-cart-count'] = ob_get_clean();

    ob_start();
    ?>
    <div class="aavni-cart-drawer-body" id="aavniCartDrawerBody">
        <?php if (WC()->cart && !WC()->cart->is_empty()) : ?>
            <ul class="aavni-drawer-items" style="list-style: none; padding: 0; margin: 0;">
                <?php
                foreach (WC()->cart->get_cart() as $cart_item_key => $cart_item) :
                    $_product = apply_filters('woocommerce_cart_item_product', $cart_item['data'], $cart_item, $cart_item_key);
                    $product_id = apply_filters('woocommerce_cart_item_product_id', $cart_item['product_id'], $cart_item, $cart_item_key);

                    if ($_product && $_product->exists() && $cart_item['quantity'] > 0) :
                        $product_permalink = apply_filters('woocommerce_cart_item_permalink', $_product->is_visible() ? $_product->get_permalink($cart_item) : '', $cart_item, $cart_item_key);
                ?>
                        <li style="display: flex; gap: 14px; margin-bottom: 18px; padding-bottom: 18px; border-bottom: 1px solid var(--aavni-border-light);">
                            <div style="width: 64px; height: 80px; flex-shrink: 0; border-radius: 4px; overflow: hidden; background: #f5f5f5;">
                                <?php echo $_product->get_image(array(64, 80)); ?>
                            </div>
                            <div style="flex-grow: 1;">
                                <h4 style="font-size: 14px; margin: 0 0 6px 0;">
                                    <a href="<?php echo esc_url($product_permalink); ?>"><?php echo wp_kses_post($_product->get_name()); ?></a>
                                </h4>
                                <div style="font-size: 13px; color: var(--aavni-text-muted);">
                                    <?php echo esc_html($cart_item['quantity']); ?> &times; <?php echo WC()->cart->get_product_price($_product); ?>
                                </div>
                            </div>
                            <div>
                                <?php
                                echo apply_filters(
                                    'woocommerce_cart_item_remove_link',
                                    sprintf(
                                        '<a href="%s" class="remove" aria-label="%s" data-product_id="%s" data-cart_item_key="%s" style="color: var(--aavni-text-subtle);">&times;</a>',
                                        esc_url(wc_get_cart_remove_url($cart_item_key)),
                                        esc_html__('Remove this item', 'aavni'),
                                        esc_attr($product_id),
                                        esc_attr($cart_item_key)
                                    ),
                                    $cart_item_key
                                );
                                ?>
                            </div>
                        </li>
                <?php
                    endif;
                endforeach;
                ?>
            </ul>
        <?php else : ?>
            <div style="text-align: center; padding: 48px 0;">
                <p style="color: var(--aavni-text-muted); font-size: 15px; margin-bottom: 20px;">Your shopping bag is currently empty.</p>
                <a href="<?php echo esc_url(wc_get_page_permalink('shop')); ?>" class="aavni-btn aavni-btn-primary" style="padding: 10px 24px; font-size: 12px;">Discover Collections</a>
            </div>
        <?php endif; ?>
    </div>
    <?php
    $fragments['div#aavniCartDrawerBody'] = ob_get_clean();

    return $fragments;
}
add_filter('woocommerce_add_to_cart_fragments', 'aavni_cart_fragments');

// 4. Helper Function: Get Brand Assets
function aavni_get_logo_url() {
    $upload_dir = wp_upload_dir();
    $logo_path = $upload_dir['baseurl'] . '/aavni/aavni-logo.png';
    return $logo_path;
}

function aavni_get_hero_banner_url() {
    $upload_dir = wp_upload_dir();
    $banner_path = $upload_dir['baseurl'] . '/aavni/aavni-hero-banner.png';
    return $banner_path;
}

// 5. Change currency symbol or formatting if needed
add_filter('woocommerce_currency_symbol', function ($currency_symbol, $currency) {
    if ($currency === 'INR') {
        $currency_symbol = '₹';
    }
    return $currency_symbol;
}, 10, 2);

