        'track-order'     => __('Track Order', 'aavni'),
        'edit-address'    => __('Saved Addresses', 'aavni'),
        'returns'         => __('Returns & Refunds', 'aavni'),
        'my-reviews'      => __('My Reviews', 'aavni'),
        'help-support'    => __('Help & Support', 'aavni'),
        'edit-account'    => __('Profile Details', 'aavni'),
        'customer-logout' => __('Logout', 'aavni'),
    );
    return $new_items;
}

