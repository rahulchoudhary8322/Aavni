// Save Phone on Edit Account
add_action('woocommerce_save_account_details', 'aavni_save_phone_on_edit_account');
function aavni_save_phone_on_edit_account($user_id) {
    if (isset($_POST['account_phone'])) {
        $phone = preg_replace('/\D/', '', sanitize_text_field($_POST['account_phone']));
        if (!empty($phone) && (strlen($phone) !== 10 || !preg_match('/^[6-9][0-9]{9}$/', $phone))) {
            wc_add_notice(__('Please enter a valid 10-digit Indian mobile number.', 'aavni'), 'error');
            return;
        }
        update_user_meta($user_id, 'billing_phone', $phone);
    }
}

// Indian PIN Code Validation on Address Save
add_action('woocommerce_after_save_address_validation', 'aavni_validate_indian_postcode', 10, 3);
function aavni_validate_indian_postcode($user_id, $load_address, $address) {
    if (isset($_POST[$load_address . '_country']) && $_POST[$load_address . '_country'] === 'IN') {
        $postcode = isset($_POST[$load_address . '_postcode']) ? trim($_POST[$load_address . '_postcode']) : '';
        if (!preg_match('/^[1-9][0-9]{5}$/', $postcode)) {
            wc_add_notice(__('Please enter a valid 6-digit Indian PIN code (e.g. 302015).', 'aavni'), 'error');
        }
    }
}

