                <h2 class="aavni-panel-title">🔄 <?php esc_html_e('Returns, Exchanges & Refund Tracking', 'aavni'); ?></h2>
                <p class="aavni-panel-subtitle"><?php esc_html_e('Easy 7-Day exchange & hassle-free returns on pure cotton apparel.', 'aavni'); ?></p>
            </div>
            <button type="button" class="aavni-btn aavni-btn-primary" onclick="document.getElementById('aavniReturnFormBox').scrollIntoView({behavior:'smooth'})">
                <?php esc_html_e('+ Request Return / Exchange', 'aavni'); ?>
            </button>
        </div>

        <!-- Requests List -->
        <?php if (!empty($requests)) : ?>
            <div class="aavni-table-responsive" style="margin-top:16px;">
                <table class="aavni-custom-table">
                    <thead>
                        <tr>
                            <th>Request ID</th>
                            <th>Order</th>
                            <th>Item</th>
                            <th>Type</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($requests as $r) :
                            $prod = wc_get_product($r->product_id);
                        ?>
                            <tr>
                                <td><strong>#RET-<?php echo esc_html($r->id); ?></strong><br><small style="color:#999;"><?php echo esc_html(substr($r->created_at, 0, 10)); ?></small></td>
                                <td>#<?php echo esc_html($r->order_id); ?></td>
                                <td><?php echo esc_html($prod ? $prod->get_name() : 'Item #' . $r->product_id); ?></td>
                                <td><span style="font-weight:600; text-transform:uppercase; color:var(--aavni-terracotta);"><?php echo esc_html($r->request_type); ?></span></td>
                                <td><?php echo esc_html($r->reason); ?></td>
                                <td>
                                    <span class="aavni-status-pill aavni-status-<?php echo esc_attr($r->status); ?>">
                                        <?php echo esc_html(str_replace('_', ' ', $r->status)); ?>
                                    </span>
                                </td>
                                <td><?php echo esc_html($r->admin_notes ?: 'Under review'); ?></td>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php else : ?>
            <div class="aavni-empty-state" style="margin-bottom:28px;">
                <p><?php esc_html_e('You have not filed any return or exchange requests.', 'aavni'); ?></p>
            </div>
        <?php endif; ?>

        <!-- New Return Request Form Box -->
        <div id="aavniReturnFormBox" class="aavni-form-card" style="margin-top:28px;">
            <h3 style="margin-top:0; font-family:var(--font-heading);"><?php esc_html_e('Submit Return / Exchange Request', 'aavni'); ?></h3>
            <p style="font-size:13px; color:var(--aavni-text-muted); margin-bottom:18px;">
                <?php esc_html_e('Items delivered within the last 7 days with intact tags are eligible for exchange or return.', 'aavni'); ?>
            </p>

            <?php if (empty($orders)) : ?>
                <div style="background:#FAF8F5; padding:16px; border-radius:6px; font-size:13px; color:var(--aavni-text-muted);">
                    <?php esc_html_e('No recently delivered orders eligible for return at this moment. If you received a damaged item, please contact our support team.', 'aavni'); ?>
                </div>
            <?php else : ?>
                <form method="post" enctype="multipart/form-data">
                    <?php wp_nonce_field('aavni_submit_return_request', 'aavni_return_nonce'); ?>
                    <input type="hidden" name="aavni_action" value="submit_return" />

                    <div class="aavni-form-grid-2">
                        <div>
                            <label for="return_order_id"><strong><?php esc_html_e('Select Delivered Order *', 'aavni'); ?></strong></label>
                            <select name="return_order_id" id="return_order_id" class="aavni-custom-input" required>
                                <?php foreach ($orders as $ord) : ?>
                                    <option value="<?php echo esc_attr($ord->get_id()); ?>">
                                        Order #<?php echo esc_html($ord->get_order_number()); ?> &mdash; <?php echo wc_price($ord->get_total(), ['currency' => $ord->get_currency()]); ?> (<?php echo esc_html($ord->get_date_created()->date('d M Y')); ?>)
                                    </option>
                                <?php endforeach; ?>
                            </select>
                        </div>
                        <div>
                            <label for="request_type"><strong><?php esc_html_e('Request Type *', 'aavni'); ?></strong></label>
                            <select name="request_type" id="request_type" class="aavni-custom-input" required>
                                <option value="exchange"><?php esc_html_e('Size / Style Exchange (Recommended)', 'aavni'); ?></option>
                                <option value="return"><?php esc_html_e('Return for Refund', 'aavni'); ?></option>
                            </select>
                        </div>
                    </div>

                    <div class="aavni-form-grid-2" style="margin-top:12px;">
                        <div>
                            <label for="return_reason"><strong><?php esc_html_e('Reason for Return / Exchange *', 'aavni'); ?></strong></label>
                            <select name="return_reason" id="return_reason" class="aavni-custom-input" required>
                                <option value="Size too small / tight"><?php esc_html_e('Size too small / tight', 'aavni'); ?></option>
                                <option value="Size too large / loose"><?php esc_html_e('Size too large / loose', 'aavni'); ?></option>
                                <option value="Color or print looks different"><?php esc_html_e('Color or print looks different', 'aavni'); ?></option>
                                <option value="Fabric / material quality issue"><?php esc_html_e('Fabric / material quality issue', 'aavni'); ?></option>
                                <option value="Defective or damaged piece"><?php esc_html_e('Defective or damaged piece', 'aavni'); ?></option>
                                <option value="Received wrong product / size"><?php esc_html_e('Received wrong product / size', 'aavni'); ?></option>
                            </select>
                        </div>
                        <div>
                            <label for="return_product_id"><strong><?php esc_html_e('Product in Order *', 'aavni'); ?></strong></label>
                            <select name="return_product_id" id="return_product_id" class="aavni-custom-input" required>
                                <?php foreach ($orders as $ord) :
                                    foreach ($ord->get_items() as $item) : ?>
                                        <option value="<?php echo esc_attr($item->get_product_id()); ?>">
                                            <?php echo esc_html($item->get_name()); ?> (Order #<?php echo esc_html($ord->get_order_number()); ?>)
                                        </option>
                                    <?php endforeach;
                                endforeach; ?>
                            </select>
                        </div>
                    </div>

                    <div style="margin-top:12px;">
                        <label for="return_description"><strong><?php esc_html_e('Detailed Description *', 'aavni'); ?></strong></label>
                        <textarea name="return_description" id="return_description" rows="3" class="aavni-custom-input" placeholder="<?php esc_attr_e('Please explain why you wish to return/exchange this item (e.g. need size L instead of M)...', 'aavni'); ?>" required></textarea>
                    </div>

                    <div style="margin-top:12px;">
                        <label for="return_photos"><strong><?php esc_html_e('Upload Supporting Photos (Optional, max 3 photos)', 'aavni'); ?></strong></label>
                        <input type="file" name="return_photos[]" id="return_photos" multiple accept="image/jpeg,image/png,image/webp" style="margin-top:4px;" />
                        <small style="display:block; color:#888;"><?php esc_html_e('Accepted: JPG, PNG, WEBP (Max 2MB per photo)', 'aavni'); ?></small>
                    </div>

                    <button type="submit" class="aavni-btn aavni-btn-primary" style="margin-top:18px;">
                        <?php esc_html_e('Submit Return / Exchange Request', 'aavni'); ?>
                    </button>
                </form>
            <?php endif; ?>
        </div>
    </div>
    <?php
}

// 3. My Reviews Endpoint Output
add_action('woocommerce_account_my-reviews_endpoint', 'aavni_render_my_reviews_endpoint');
function aavni_render_my_reviews_endpoint() {
    $user_id = get_current_user_id();

    // Query customer's existing reviews
    $reviews = get_comments([
        'user_id' => $user_id,
        'type'    => 'review',
        'status'  => 'all',
    ]);

    // Query bought products to allow easy new review writing
    $customer_orders = wc_get_orders(['customer' => $user_id, 'status' => ['completed', 'processing'], 'limit' => 15]);
    $bought_product_ids = [];
    foreach ($customer_orders as $ord) {
        foreach ($ord->get_items() as $item) {
            $bought_product_ids[$item->get_product_id()] = $item->get_name();
        }
    }
    ?>
    <div class="aavni-panel-section">
        <div class="aavni-panel-header">
            <h2 class="aavni-panel-title">⭐ <?php esc_html_e('My Ratings & Product Reviews', 'aavni'); ?></h2>
            <p class="aavni-panel-subtitle"><?php esc_html_e('Share your feedback on fit, fabric, and styling to help our community.', 'aavni'); ?></p>
        </div>

        <?php if (!empty($reviews)) : ?>
            <div class="aavni-reviews-list" style="margin-top:18px;">
                <?php foreach ($reviews as $rev) :
                    $prod = wc_get_product($rev->comment_post_ID);
                    $rating = intval(get_comment_meta($rev->comment_ID, 'rating', true));
                ?>
                    <div class="aavni-review-card" style="background:#fff; border:1px solid var(--aavni-border-light); border-radius:8px; padding:18px; margin-bottom:14px; box-shadow:var(--shadow-sm);">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
                            <div>
                                <h4 style="margin:0 0 4px; font-size:15px;">
                                    <?php if ($prod) : ?>
                                        <a href="<?php echo esc_url($prod->get_permalink()); ?>" target="_blank" style="color:var(--aavni-text); font-weight:600;">
                                            <?php echo esc_html($prod->get_name()); ?> ↗
                                        </a>
                                    <?php else : ?>
                                        <?php esc_html_e('Product', 'aavni'); ?>
                                    <?php endif; ?>
                                </h4>
                                <div style="color:#E67A00; font-size:14px;">
                                    <?php echo str_repeat('★', $rating) . str_repeat('☆', 5 - $rating); ?>
                                    <span style="font-size:12px; color:var(--aavni-text-subtle); margin-left:6px;"><?php echo esc_html(get_comment_date('d M Y', $rev)); ?></span>
                                </div>
                            </div>
                            <?php if ($rev->comment_approved === '1') : ?>
                                <span style="background:#ECFDF5; color:#047857; font-size:11px; font-weight:700; padding:2px 8px; border-radius:4px;">Published</span>
                            <?php else : ?>
                                <span style="background:#FEF3C7; color:#92400E; font-size:11px; font-weight:700; padding:2px 8px; border-radius:4px;">Awaiting Moderation</span>
                            <?php endif; ?>
                        </div>
                        <p style="margin:0; font-size:13.5px; color:var(--aavni-text-muted); line-height:1.6;">
                            <?php echo esc_html($rev->comment_content); ?>
                        </p>
                    </div>
                <?php endforeach; ?>
            </div>
        <?php else : ?>
            <div class="aavni-empty-state">
                <div class="aavni-empty-icon">✍️</div>
                <h3><?php esc_html_e('No product reviews yet', 'aavni'); ?></h3>
                <p><?php esc_html_e('You have not reviewed any purchased items yet.', 'aavni'); ?></p>
            </div>
        <?php endif; ?>

        <!-- Write a Review Section -->
        <?php if (!empty($bought_product_ids)) : ?>
            <div class="aavni-form-card" style="margin-top:24px;">
                <h4 style="margin:0 0 10px; font-family:var(--font-heading);"><?php esc_html_e('Review Purchased Products', 'aavni'); ?></h4>
                <p style="font-size:13px; color:var(--aavni-text-muted); margin-bottom:14px;">
                    <?php esc_html_e('Click any item you recently ordered to rate and review it:', 'aavni'); ?>
                </p>
                <div style="display:flex; flex-wrap:wrap; gap:8px;">
                    <?php foreach ($bought_product_ids as $pid => $pname) :
                        $p = wc_get_product($pid);
                        if ($p) :
                    ?>
                        <a href="<?php echo esc_url($p->get_permalink() . '#reviews'); ?>" class="aavni-btn aavni-btn-sm aavni-btn-outline" style="text-align:left;">
                            ⭐ <?php echo esc_html($pname); ?> &rarr;
                        </a>
                    <?php endif; endforeach; ?>
                </div>
            </div>
        <?php endif; ?>
    </div>
    <?php
}

// 4. Help & Support Endpoint Output
add_action('woocommerce_account_help-support_endpoint', 'aavni_render_help_support_endpoint');
function aavni_render_help_support_endpoint() {
