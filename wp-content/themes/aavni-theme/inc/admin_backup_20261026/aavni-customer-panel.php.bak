    $table = $wpdb->prefix . 'aavni_support_tickets';
    $tickets = $wpdb->get_results($wpdb->prepare("SELECT * FROM $table WHERE customer_id = %d ORDER BY id DESC", $user_id));
    $orders = wc_get_orders(['customer' => $user_id, 'limit' => 15]);
    ?>
    <div class="aavni-panel-section">
        <div class="aavni-panel-header">
            <h2 class="aavni-panel-title">💬 <?php esc_html_e('AAVNI Customer Care & Support', 'aavni'); ?></h2>
            <p class="aavni-panel-subtitle"><?php esc_html_e('Get quick assistance with delivery, exchanges, sizing, or billing.', 'aavni'); ?></p>
        </div>

        <!-- 3 Contact Methods Grid -->
        <div class="aavni-support-cards-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:14px; margin-top:16px;">
            <div class="aavni-contact-card" style="background:#FAF8F5; border:1px solid var(--aavni-border); border-radius:8px; padding:18px;">
