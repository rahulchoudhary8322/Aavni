                            <td>
                                <a href="<?php echo esc_url(admin_url('post.php?post=' . $req->order_id . '&action=edit')); ?>" target="_blank">
                                    #<?php echo esc_html($req->order_id); ?> ↗
                                </a>
                            </td>
                            <td><?php echo esc_html($cust ? $cust->display_name . ' (' . $cust->user_email . ')' : 'User #' . $req->customer_id); ?></td>
                            <td><?php echo esc_html($prod ? $prod->get_name() : 'Product #' . $req->product_id); ?></td>
                            <td><span style="font-weight:600; text-transform:uppercase; color:#A85A48;"><?php echo esc_html($req->request_type); ?></span></td>
                            <td>
                                <strong><?php echo esc_html($req->reason); ?></strong>
                                <p style="margin:4px 0 0; font-size:12px; color:#555;"><?php echo esc_html($req->description); ?></p>
                            </td>
                            <td>
                                <?php if (!empty($photos)) : ?>
                                    <div style="display:flex; gap:6px; flex-wrap:wrap;">
                                        <?php foreach ($photos as $p_url) : ?>
                                            <a href="<?php echo esc_url($p_url); ?>" target="_blank">
                                                <img src="<?php echo esc_url($p_url); ?>" style="width:36px; height:36px; object-fit:cover; border-radius:3px; border:1px solid #ccc;">
                                            </a>
                                        <?php endforeach; ?>
                                    </div>
                                <?php else : ?>
                                    <span style="color:#999; font-size:12px;">None</span>
                                <?php endif; ?>
                            </td>
                            <td>
                                <span class="badge" style="display:inline-block; padding:3px 8px; border-radius:4px; font-size:11px; font-weight:700; text-transform:uppercase; background:<?php echo ($req->status === 'approved') ? '#D1FAE5; color:#065F46;' : (($req->status === 'rejected') ? '#FEE2E2; color:#991B1B;' : '#FEF3C7; color:#92400E;'); ?>">
                                    <?php echo esc_html($req->status); ?>
                                </span>
                            </td>
                            <td>
                                <form method="post" style="margin:0;">
                                    <?php wp_nonce_field('aavni_admin_return_nonce'); ?>
