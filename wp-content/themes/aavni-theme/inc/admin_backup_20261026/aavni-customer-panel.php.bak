if (!defined('ABSPATH')) {
    exit;
}

define('AAVNI_PANEL_VERSION', '1.0.0');

/**
 * ============================================================================
 * 1. DATABASE SCHEMA: RETURNS & SUPPORT TICKETS
 * ============================================================================
 */
function aavni_install_panel_database() {
    global $wpdb;

    $installed_ver = get_option('aavni_panel_db_version', '0');
    if (version_compare($installed_ver, AAVNI_PANEL_VERSION, '<')) {
        require_once ABSPATH . 'wp-admin/includes/upgrade.php';
        $charset_collate = $wpdb->get_charset_collate();

        // 1. Returns & Exchange Requests Table
        $table_returns = $wpdb->prefix . 'aavni_returns';
        $sql_returns = "CREATE TABLE $table_returns (
            id bigint(20) unsigned NOT NULL AUTO_INCREMENT,
            order_id bigint(20) unsigned NOT NULL,
            customer_id bigint(20) unsigned NOT NULL,
            product_id bigint(20) unsigned NOT NULL,
            quantity int(11) NOT NULL DEFAULT 1,
            request_type varchar(30) NOT NULL DEFAULT 'return',
            reason varchar(255) NOT NULL,
            description text NOT NULL,
            photos longtext DEFAULT NULL,
            status varchar(50) NOT NULL DEFAULT 'submitted',
            admin_notes text DEFAULT NULL,
            created_at datetime NOT NULL,
            updated_at datetime NOT NULL,
            PRIMARY KEY (id),
            KEY order_id (order_id),
            KEY customer_id (customer_id),
            KEY status (status)
        ) $charset_collate;";
        dbDelta($sql_returns);

        // 2. Customer Support Tickets & Complaints Table
        $table_tickets = $wpdb->prefix . 'aavni_support_tickets';
        $sql_tickets = "CREATE TABLE $table_tickets (
            id bigint(20) unsigned NOT NULL AUTO_INCREMENT,
            ticket_code varchar(40) NOT NULL,
            customer_id bigint(20) unsigned NOT NULL,
            order_id bigint(20) unsigned DEFAULT 0,
            subject varchar(255) NOT NULL,
            category varchar(100) NOT NULL,
            description text NOT NULL,
            status varchar(50) NOT NULL DEFAULT 'open',
            priority varchar(30) NOT NULL DEFAULT 'medium',
            replies longtext DEFAULT NULL,
            created_at datetime NOT NULL,
            updated_at datetime NOT NULL,
            PRIMARY KEY (id),
            UNIQUE KEY ticket_code (ticket_code),
            KEY customer_id (customer_id),
            KEY order_id (order_id),
            KEY status (status)
        ) $charset_collate;";
        dbDelta($sql_tickets);

        update_option('aavni_panel_db_version', AAVNI_PANEL_VERSION);
    }
}
add_action('init', 'aavni_install_panel_database', 5);

/**
 * ============================================================================
 * 2. REWRITE ENDPOINTS & NAVIGATION
 * ============================================================================
 */
function aavni_register_account_endpoints() {
    add_rewrite_endpoint('track-order', EP_ROOT | EP_PAGES);
    add_rewrite_endpoint('returns', EP_ROOT | EP_PAGES);
    add_rewrite_endpoint('my-reviews', EP_ROOT | EP_PAGES);
    add_rewrite_endpoint('help-support', EP_ROOT | EP_PAGES);

    // Flush rewrite rules once if needed
    if (get_option('aavni_panel_flushed_rewrites') !== AAVNI_PANEL_VERSION) {
        flush_rewrite_rules(false);
        update_option('aavni_panel_flushed_rewrites', AAVNI_PANEL_VERSION);
    }
}
add_action('init', 'aavni_register_account_endpoints', 10);

// Add custom endpoints to WooCommerce query vars
add_filter('woocommerce_get_query_vars', function($vars) {
    $vars['track-order'] = 'track-order';
    $vars['returns'] = 'returns';
    $vars['my-reviews'] = 'my-reviews';
    $vars['help-support'] = 'help-support';
    return $vars;
});

// Configure My Account menu items and order
add_filter('woocommerce_account_menu_items', 'aavni_custom_account_menu_items', 99);
function aavni_custom_account_menu_items($items) {
    $new_items = array(
        'dashboard'       => __('Overview', 'aavni'),
