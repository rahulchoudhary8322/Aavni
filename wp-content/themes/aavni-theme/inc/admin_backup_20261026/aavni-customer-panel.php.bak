function aavni_render_admin_tickets_page() {
    global $wpdb;
    $table = $wpdb->prefix . 'aavni_support_tickets';

    // Handle Admin Reply / Status update
    if (isset($_POST['aavni_admin_ticket_action']) && check_admin_referer('aavni_admin_ticket_nonce')) {
        $tkt_id = absint($_POST['ticket_id']);
        $new_status = sanitize_text_field($_POST['ticket_status']);
        $reply_text = sanitize_textarea_field($_POST['admin_reply']);

        $existing = $wpdb->get_row($wpdb->prepare("SELECT replies FROM $table WHERE id = %d", $tkt_id));
        $replies = $existing ? (json_decode($existing->replies, true) ?: []) : [];

        if (!empty($reply_text)) {
            $replies[] = [
                'author'  => wp_get_current_user()->display_name . ' (AAVNI Support)',
                'message' => $reply_text,
                'time'    => current_time('mysql'),
            ];
        }

        $wpdb->update(
            $table,
            [
                'status'     => $new_status,
                'replies'    => json_encode($replies),
                'updated_at' => current_time('mysql'),
            ],
            ['id' => $tkt_id],
            ['%s', '%s', '%s'],
            ['%d']
        );
        echo '<div class="notice notice-success is-dismissible"><p>' . esc_html__('Ticket response recorded.', 'aavni') . '</p></div>';
    }

    $tickets = $wpdb->get_results("SELECT * FROM $table ORDER BY id DESC LIMIT 50");
