// Handle Support Ticket Submission
add_action('template_redirect', 'aavni_handle_support_ticket_submission');
function aavni_handle_support_ticket_submission() {
    if (!isset($_POST['aavni_action']) || $_POST['aavni_action'] !== 'submit_support_ticket') {
        return;
    }

    if (!is_user_logged_in()) {
        wc_add_notice(__('Please log in to submit a support inquiry.', 'aavni'), 'error');
        wp_safe_redirect(wc_get_account_endpoint_url('help-support'));
        exit;
    }

    if (!isset($_POST['aavni_ticket_nonce']) || !wp_verify_nonce($_POST['aavni_ticket_nonce'], 'aavni_submit_support_ticket')) {
        wc_add_notice(__('Security check failed. Please refresh and try again.', 'aavni'), 'error');
        wp_safe_redirect(wc_get_account_endpoint_url('help-support'));
        exit;
    }

    $customer_id = get_current_user_id();
    $subject = sanitize_text_field($_POST['ticket_subject']);
    $category = sanitize_text_field($_POST['ticket_category']);
    $order_id = isset($_POST['ticket_order_id']) ? absint($_POST['ticket_order_id']) : 0;
    $description = sanitize_textarea_field($_POST['ticket_description']);

    if (empty($subject) || empty($description)) {
        wc_add_notice(__('Please enter a subject and detailed description for your inquiry.', 'aavni'), 'error');
        wp_safe_redirect(wc_get_account_endpoint_url('help-support'));
        exit;
    }

    $ticket_code = 'AAVNI-TKT-' . strtoupper(wp_generate_password(6, false));

    global $wpdb;
    $table = $wpdb->prefix . 'aavni_support_tickets';
    $wpdb->insert(
        $table,
        [
            'ticket_code' => $ticket_code,
            'customer_id' => $customer_id,
            'order_id'    => $order_id,
            'subject'     => $subject,
            'category'    => $category,
            'description' => $description,
            'status'      => 'open',
            'priority'    => 'medium',
            'created_at'  => current_time('mysql'),
            'updated_at'  => current_time('mysql'),
        ],
        ['%s', '%d', '%d', '%s', '%s', '%s', '%s', '%s', '%s', '%s']
    );

    wc_add_notice(sprintf(__('Support Ticket #%s created. Our customer support team will reply within 24 hours.', 'aavni'), $ticket_code), 'success');
    wp_safe_redirect(wc_get_account_endpoint_url('help-support'));
    exit;
}

