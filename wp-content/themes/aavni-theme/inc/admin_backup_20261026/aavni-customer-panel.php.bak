// Customer Order Cancellation Action
add_action('template_redirect', 'aavni_handle_order_cancellation');
function aavni_handle_order_cancellation() {
    if (!isset($_GET['aavni_action']) || $_GET['aavni_action'] !== 'cancel_order') {
        return;
    }

    if (!is_user_logged_in()) {
        wc_add_notice(__('You must be logged in to cancel an order.', 'aavni'), 'error');
        wp_safe_redirect(wc_get_account_endpoint_url('orders'));
        exit;
    }

    $order_id = isset($_GET['order_id']) ? absint($_GET['order_id']) : 0;
    $nonce = isset($_GET['_wpnonce']) ? sanitize_text_field($_GET['_wpnonce']) : '';

    if (!wp_verify_nonce($nonce, 'aavni_cancel_order_' . $order_id)) {
        wc_add_notice(__('Security verification failed. Please try again.', 'aavni'), 'error');
        wp_safe_redirect(wc_get_account_endpoint_url('orders'));
        exit;
    }

    $order = wc_get_order($order_id);
    if (!$order || $order->get_customer_id() !== get_current_user_id()) {
        wc_add_notice(__('You do not have permission to modify this order.', 'aavni'), 'error');
        wp_safe_redirect(wc_get_account_endpoint_url('orders'));
        exit;
    }

    // Eligibility check: Allowed if status is pending, on-hold, or processing (before packed/shipped)
    $status = $order->get_status();
    $milestone = $order->get_meta('_aavni_order_milestone') ?: 'confirmed';

    if (!in_array($status, ['pending', 'on-hold', 'processing'], true) || in_array($milestone, ['packed', 'shipped', 'out_for_delivery', 'delivered'], true)) {
        wc_add_notice(__('This order cannot be cancelled because it has already been packed or dispatched. You can request a return after delivery.', 'aavni'), 'error');
        wp_safe_redirect(wc_get_account_endpoint_url('orders'));
        exit;
    }

    // Process cancellation through native WooCommerce lifecycle
    $order->update_status('cancelled', __('Order cancelled directly by customer via AAVNI Customer Panel.', 'aavni'));
    $order->update_meta_data('_aavni_order_milestone', 'cancelled');
    
    // Add to milestone history
    $raw_history = $order->get_meta('_aavni_milestone_history');
    $history = is_array($raw_history) ? $raw_history : [];
    $history[] = [
        'milestone' => 'cancelled',
        'title'     => 'Order Cancelled',
        'note'      => 'Cancelled by customer',
        'time'      => current_time('mysql'),
    ];
    $order->update_meta_data('_aavni_milestone_history', $history);
    $order->save();

    wc_add_notice(sprintf(__('Order #%s has been cancelled successfully.', 'aavni'), $order->get_order_number()), 'success');
    wp_safe_redirect(wc_get_account_endpoint_url('orders'));
    exit;
}

// Printable Invoice Generator
add_action('template_redirect', 'aavni_handle_invoice_print');
function aavni_handle_invoice_print() {
    if (!isset($_GET['aavni_action']) || $_GET['aavni_action'] !== 'print_invoice') {
        return;
    }

    $order_id = isset($_GET['order_id']) ? absint($_GET['order_id']) : 0;
    $nonce = isset($_GET['_wpnonce']) ? sanitize_text_field($_GET['_wpnonce']) : '';

    if (!wp_verify_nonce($nonce, 'aavni_invoice_' . $order_id)) {
        wp_die(__('Invalid or expired invoice link.', 'aavni'), __('Access Denied', 'aavni'), ['response' => 403]);
    }

    $order = wc_get_order($order_id);
    if (!$order) {
        wp_die(__('Order not found.', 'aavni'), __('Error', 'aavni'), ['response' => 404]);
    }

    // Authorization check
    $user_id = get_current_user_id();
    if ($order->get_customer_id() !== $user_id && !current_user_can('manage_woocommerce')) {
        wp_die(__('You do not have permission to view this invoice.', 'aavni'), __('Access Denied', 'aavni'), ['response' => 403]);
    }

    aavni_render_printable_invoice($order);
    exit;
}

