// 1. Track Order Endpoint Output
add_action('woocommerce_account_track-order_endpoint', 'aavni_render_track_order_endpoint');
function aavni_render_track_order_endpoint() {
    $user_id = get_current_user_id();
    $orders = wc_get_orders(['customer' => $user_id, 'limit' => 20]);
    $selected_order_id = isset($_GET['order_id']) ? absint($_GET['order_id']) : ($orders ? $orders[0]->get_id() : 0);
    $selected_order = $selected_order_id ? wc_get_order($selected_order_id) : null;

    // Verify ownership
    if ($selected_order && $selected_order->get_customer_id() !== $user_id) {
        $selected_order = null;
    }

    $milestones = aavni_get_milestone_definitions();
    ?>
    <div class="aavni-panel-section">
        <div class="aavni-panel-header">
            <h2 class="aavni-panel-title">🚚 <?php esc_html_e('Order Tracking & Status Timeline', 'aavni'); ?></h2>
            <p class="aavni-panel-subtitle"><?php esc_html_e('Track your package through real-time packaging, transit, and delivery milestones.', 'aavni'); ?></p>
        </div>

        <?php if (empty($orders)) : ?>
            <div class="aavni-empty-state">
                <div class="aavni-empty-icon">📦</div>
                <h3><?php esc_html_e('No orders to track yet', 'aavni'); ?></h3>
                <p><?php esc_html_e('Once you make a purchase, your real-time tracking timeline will appear here.', 'aavni'); ?></p>
                <a href="<?php echo esc_url(wc_get_page_permalink('shop')); ?>" class="aavni-btn aavni-btn-primary"><?php esc_html_e('Explore Collections', 'aavni'); ?></a>
            </div>
        <?php else : ?>
            <!-- Order Selector -->
            <div class="aavni-track-selector-bar">
                <form method="get" action="" style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                    <label for="track_order_select" style="font-weight:600; font-size:13.5px;"><?php esc_html_e('Select Order to Track:', 'aavni'); ?></label>
                    <select name="order_id" id="track_order_select" class="aavni-custom-select" onchange="this.form.submit()">
                        <?php foreach ($orders as $ord) : ?>
                            <option value="<?php echo esc_attr($ord->get_id()); ?>" <?php selected($selected_order_id, $ord->get_id()); ?>>
                                Order #<?php echo esc_html($ord->get_order_number()); ?> &mdash; <?php echo wc_price($ord->get_total(), ['currency' => $ord->get_currency()]); ?> (<?php echo esc_html($ord->get_date_created()->date('d M Y')); ?>)
                            </option>
                        <?php endforeach; ?>
                    </select>
                </form>
            </div>

            <?php if ($selected_order) :
                $current_milestone = aavni_get_order_current_milestone($selected_order);
                $courier = $selected_order->get_meta('_aavni_courier_name');
                $tracking_no = $selected_order->get_meta('_aavni_tracking_number');
                $tracking_url = $selected_order->get_meta('_aavni_tracking_url');
                $raw_history = $selected_order->get_meta('_aavni_milestone_history');
                $history = is_array($raw_history) ? $raw_history : [];

                $current_step = isset($milestones[$current_milestone]) ? $milestones[$current_milestone]['step'] : 1;
                $is_cancelled = in_array($current_milestone, ['cancelled', 'refunded', 'failed'], true);
            ?>
                <!-- Order Overview Card -->
                <div class="aavni-order-track-card">
                    <div class="aavni-track-meta-row">
                        <div>
                            <span class="aavni-track-label"><?php esc_html_e('ORDER NUMBER', 'aavni'); ?></span>
                            <div class="aavni-track-val">#<?php echo esc_html($selected_order->get_order_number()); ?></div>
                        </div>
                        <div>
                            <span class="aavni-track-label"><?php esc_html_e('ORDER DATE', 'aavni'); ?></span>
                            <div class="aavni-track-val"><?php echo esc_html($selected_order->get_date_created()->date('d M Y, h:i A')); ?></div>
                        </div>
                        <div>
                            <span class="aavni-track-label"><?php esc_html_e('TOTAL AMOUNT', 'aavni'); ?></span>
                            <div class="aavni-track-val" style="color:var(--aavni-terracotta);"><?php echo wc_price($selected_order->get_total(), ['currency' => $selected_order->get_currency()]); ?></div>
                        </div>
                        <div>
                            <span class="aavni-track-label"><?php esc_html_e('PAYMENT', 'aavni'); ?></span>
                            <div class="aavni-track-val"><?php echo esc_html($selected_order->get_payment_method_title()); ?></div>
                        </div>
                    </div>

                    <!-- Courier Info Box -->
                    <div class="aavni-courier-info-box">
                        <div class="aavni-courier-details">
                            <strong>📦 <?php esc_html_e('Shipment Partner:', 'aavni'); ?></strong>
                            <span><?php echo esc_html($courier ?: 'AAVNI Express Delivery'); ?></span>
                            <?php if ($tracking_no) : ?>
                                <span style="margin-left:12px;"><strong>AWB:</strong> <code><?php echo esc_html($tracking_no); ?></code></span>
                            <?php endif; ?>
                        </div>
                        <?php if ($tracking_url) : ?>
                            <a href="<?php echo esc_url($tracking_url); ?>" target="_blank" rel="noopener" class="aavni-btn aavni-btn-sm aavni-btn-outline">
                                <?php esc_html_e('Live Courier Tracking ↗', 'aavni'); ?>
                            </a>
                        <?php endif; ?>
                    </div>

                    <?php if ($is_cancelled) : ?>
                        <div class="aavni-alert-cancelled" style="margin-top:20px; padding:16px; background:#FEF2F2; border:1px solid #FCA5A5; border-radius:8px; color:#991B1B;">
                            <strong>⚠️ <?php printf(esc_html__('This order is %s.', 'aavni'), strtoupper(esc_html($current_milestone))); ?></strong>
                            <p style="margin:4px 0 0; font-size:13px;"><?php esc_html_e('Delivery for this order has been stopped according to customer or store request.', 'aavni'); ?></p>
                        </div>
                    <?php else : ?>
                        <!-- Visual Milestone Timeline -->
                        <div class="aavni-timeline-wrapper">
                            <div class="aavni-timeline-track">
                                <div class="aavni-timeline-progress" style="width: <?php echo esc_attr(($current_step - 1) * 20); ?>%;"></div>
                            </div>
                            <div class="aavni-timeline-nodes">
                                <?php foreach ($milestones as $key => $m) :
                                    $is_done = $m['step'] < $current_step;
                                    $is_active = $m['step'] === $current_step;
                                ?>
                                    <div class="aavni-timeline-node <?php echo $is_done ? 'is-done' : ($is_active ? 'is-active' : 'is-pending'); ?>">
                                        <div class="aavni-node-bubble">
                                            <?php echo $is_done ? '✓' : esc_html($m['icon']); ?>
                                        </div>
                                        <div class="aavni-node-title"><?php echo esc_html($m['label']); ?></div>
                                    </div>
                                <?php endforeach; ?>
                            </div>
                        </div>
                    <?php endif; ?>

                    <!-- Milestone History Log -->
                    <?php if (!empty($history)) : ?>
                        <div class="aavni-milestone-history-log" style="margin-top:24px; border-top:1px solid var(--aavni-border-light); padding-top:16px;">
                            <h4 style="font-size:14px; margin:0 0 10px;"><?php esc_html_e('Activity Log & Updates', 'aavni'); ?></h4>
                            <ul style="list-style:none; padding:0; margin:0; font-size:12.5px; color:var(--aavni-text-muted);">
                                <?php foreach (array_reverse($history) as $h) :
                                    if (!is_array($h) || empty($h['title'])) continue;
                                ?>
                                    <li style="display:flex; gap:12px; margin-bottom:6px;">
                                        <span style="color:var(--aavni-text-subtle);"><?php echo esc_html(isset($h['time']) ? substr($h['time'], 0, 16) : ''); ?></span>
                                        <strong><?php echo esc_html($h['title']); ?></strong>
                                        <?php if (!empty($h['note'])) : ?>
                                            <span>&mdash; <?php echo esc_html($h['note']); ?></span>
                                        <?php endif; ?>
                                    </li>
                                <?php endforeach; ?>
                            </ul>
                        </div>
                    <?php endif; ?>
                </div>
            <?php endif; ?>
        <?php endif; ?>
    </div>
    <?php
}

// 2. Returns & Refunds Endpoint Output
add_action('woocommerce_account_returns_endpoint', 'aavni_render_returns_endpoint');
function aavni_render_returns_endpoint() {
    $user_id = get_current_user_id();
    global $wpdb;
    $table = $wpdb->prefix . 'aavni_returns';
    $requests = $wpdb->get_results($wpdb->prepare("SELECT * FROM $table WHERE customer_id = %d ORDER BY id DESC", $user_id));

    // Get orders eligible for return (status = completed, within 7 days)
    $orders = wc_get_orders([
        'customer' => $user_id,
        'status'   => ['completed'],
        'limit'    => 10,
    ]);
    ?>
    <div class="aavni-panel-section">
        <div class="aavni-panel-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
