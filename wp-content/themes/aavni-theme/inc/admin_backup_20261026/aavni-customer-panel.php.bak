                                    <?php wp_nonce_field('aavni_admin_ticket_nonce'); ?>
                                    <input type="hidden" name="aavni_admin_ticket_action" value="1" />
                                    <input type="hidden" name="ticket_id" value="<?php echo esc_attr($tkt->id); ?>" />
                                    <textarea name="admin_reply" rows="2" placeholder="Type reply to customer..." style="width:100%; font-size:12px; margin-bottom:4px;"></textarea>
                                    <div style="display:flex; gap:6px;">
                                        <select name="ticket_status" style="font-size:12px; flex:1;">
                                            <option value="open" <?php selected($tkt->status, 'open'); ?>>Open</option>
                                            <option value="in_progress" <?php selected($tkt->status, 'in_progress'); ?>>In Progress</option>
                                            <option value="resolved" <?php selected($tkt->status, 'resolved'); ?>>Resolved</option>
                                            <option value="closed" <?php selected($tkt->status, 'closed'); ?>>Closed</option>
                                        </select>
                                        <button type="submit" class="button button-small button-primary">Send & Update</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                <?php endif; ?>
            </tbody>
        </table>
    </div>
    <?php
}

/**
 * ============================================================================
