// Handle Customer Return / Exchange Form Submission
add_action('template_redirect', 'aavni_handle_return_submission');
function aavni_handle_return_submission() {
    if (!isset($_POST['aavni_action']) || $_POST['aavni_action'] !== 'submit_return') {
        return;
    }

    if (!is_user_logged_in()) {
        wc_add_notice(__('Please log in to submit a return request.', 'aavni'), 'error');
        wp_safe_redirect(wc_get_account_endpoint_url('returns'));
        exit;
    }

    if (!isset($_POST['aavni_return_nonce']) || !wp_verify_nonce($_POST['aavni_return_nonce'], 'aavni_submit_return_request')) {
        wc_add_notice(__('Security check failed. Please refresh and try again.', 'aavni'), 'error');
        wp_safe_redirect(wc_get_account_endpoint_url('returns'));
        exit;
    }

    $customer_id = get_current_user_id();
    $order_id = isset($_POST['return_order_id']) ? absint($_POST['return_order_id']) : 0;
    $product_id = isset($_POST['return_product_id']) ? absint($_POST['return_product_id']) : 0;
    $request_type = isset($_POST['request_type']) ? sanitize_text_field($_POST['request_type']) : 'return';
    $reason = isset($_POST['return_reason']) ? sanitize_text_field($_POST['return_reason']) : '';
    $description = isset($_POST['return_description']) ? sanitize_textarea_field($_POST['return_description']) : '';

    $order = wc_get_order($order_id);
    if (!$order || $order->get_customer_id() !== $customer_id) {
        wc_add_notice(__('Invalid order specified for return.', 'aavni'), 'error');
        wp_safe_redirect(wc_get_account_endpoint_url('returns'));
        exit;
    }

    if (empty($reason) || empty($description)) {
        wc_add_notice(__('Please specify a reason and description for your return/exchange request.', 'aavni'), 'error');
        wp_safe_redirect(wc_get_account_endpoint_url('returns'));
        exit;
    }

    // Photo uploads handling
    $uploaded_photos = [];
    if (!empty($_FILES['return_photos']['name'][0])) {
        require_once ABSPATH . 'wp-admin/includes/file.php';
        require_once ABSPATH . 'wp-admin/includes/image.php';
        require_once ABSPATH . 'wp-admin/includes/media.php';

        $files = $_FILES['return_photos'];
        $count = count($files['name']);
        for ($i = 0; $i < min($count, 3); $i++) {
            if ($files['error'][$i] === 0) {
                // Check mime type
                $file_type = wp_check_filetype($files['name'][$i]);
                if (in_array(strtolower($file_type['ext']), ['jpg', 'jpeg', 'png', 'webp'])) {
                    $upload = wp_upload_bits($files['name'][$i], null, file_get_contents($files['tmp_name'][$i]));
                    if (empty($upload['error'])) {
                        $uploaded_photos[] = $upload['url'];
                    }
                }
            }
        }
    }

    global $wpdb;
    $table = $wpdb->prefix . 'aavni_returns';
    $wpdb->insert(
        $table,
        [
            'order_id'     => $order_id,
            'customer_id'  => $customer_id,
            'product_id'   => $product_id,
            'quantity'     => 1,
            'request_type' => $request_type,
            'reason'       => $reason,
            'description'  => $description,
            'photos'       => json_encode($uploaded_photos),
            'status'       => 'submitted',
            'created_at'   => current_time('mysql'),
            'updated_at'   => current_time('mysql'),
        ],
        ['%d', '%d', '%d', '%d', '%s', '%s', '%s', '%s', '%s', '%s', '%s']
    );

    $order->add_order_note(sprintf(__('Customer submitted a %s request for product #%d. Reason: %s', 'aavni'), strtoupper($request_type), $product_id, $reason));

    wc_add_notice(__('Your return/exchange request has been submitted successfully. Our support team will review it within 24-48 business hours.', 'aavni'), 'success');
    wp_safe_redirect(wc_get_account_endpoint_url('returns'));
    exit;
}

