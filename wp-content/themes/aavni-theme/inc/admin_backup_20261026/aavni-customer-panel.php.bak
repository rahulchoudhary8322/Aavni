/**
 * ============================================================================
 * 5. PHASE 3 — ORDER TRACKING & SHIPMENT MILESTONES
 * ============================================================================
 */

function aavni_get_milestone_definitions() {
    return [
        'confirmed'        => ['label' => __('Order Confirmed', 'aavni'), 'icon' => '📝', 'step' => 1],
        'processing'       => ['label' => __('Processing & QC', 'aavni'), 'icon' => '⚙️', 'step' => 2],
        'packed'           => ['label' => __('Packed for Dispatch', 'aavni'), 'icon' => '📦', 'step' => 3],
        'shipped'          => ['label' => __('Dispatched / In Transit', 'aavni'), 'icon' => '🚚', 'step' => 4],
        'out_for_delivery' => ['label' => __('Out for Delivery', 'aavni'), 'icon' => '🛵', 'step' => 5],
        'delivered'        => ['label' => __('Delivered', 'aavni'), 'icon' => '🎉', 'step' => 6],
    ];
}

function aavni_get_order_current_milestone($order) {
    $meta = $order->get_meta('_aavni_order_milestone');
    if (!empty($meta)) {
        return $meta;
    }
    // Fallback to WC native order status
    $wc_status = $order->get_status();
    if ($wc_status === 'completed') return 'delivered';
    if ($wc_status === 'cancelled') return 'cancelled';
    if ($wc_status === 'refunded') return 'refunded';
    if ($wc_status === 'failed') return 'failed';
    if ($wc_status === 'processing') return 'processing';
    return 'confirmed';
}

// Add Shipment Tracking & Milestones Metabox in Admin Order Screen
add_action('add_meta_boxes', 'aavni_add_shipment_tracking_metabox');
function aavni_add_shipment_tracking_metabox() {
