        $screen,
        'side',
        'high'
    );
}

function aavni_render_shipment_tracking_metabox($post_or_order_object) {
    $order = ($post_or_order_object instanceof WC_Order) ? $post_or_order_object : wc_get_order($post_or_order_object->ID);
    if (!$order) return;

    $current_milestone = aavni_get_order_current_milestone($order);
    $courier = $order->get_meta('_aavni_courier_name');
    $tracking_number = $order->get_meta('_aavni_tracking_number');
    $tracking_url = $order->get_meta('_aavni_tracking_url');
    $milestones = aavni_get_milestone_definitions();

    wp_nonce_field('aavni_save_shipment_meta', 'aavni_shipment_nonce');
    ?>
    <p>
        <label for="aavni_order_milestone"><strong><?php esc_html_e('Current Shipment Milestone:', 'aavni'); ?></strong></label><br>
        <select name="aavni_order_milestone" id="aavni_order_milestone" style="width:100%; margin-top:4px;">
            <?php foreach ($milestones as $key => $data) : ?>
                <option value="<?php echo esc_attr($key); ?>" <?php selected($current_milestone, $key); ?>>
                    <?php echo esc_html($data['icon'] . ' ' . $data['label']); ?>
                </option>
            <?php endforeach; ?>
            <option value="cancelled" <?php selected($current_milestone, 'cancelled'); ?>>❌ Cancelled</option>
            <option value="refunded" <?php selected($current_milestone, 'refunded'); ?>>🔄 Refunded</option>
        </select>
    </p>
    <p>
        <label for="aavni_courier_name"><strong><?php esc_html_e('Courier Partner:', 'aavni'); ?></strong></label><br>
        <input type="text" name="aavni_courier_name" id="aavni_courier_name" value="<?php echo esc_attr($courier); ?>" placeholder="e.g. Delhivery / BlueDart / Shiprocket" style="width:100%; margin-top:4px;" />
    </p>
    <p>
        <label for="aavni_tracking_number"><strong><?php esc_html_e('AWB / Tracking Number:', 'aavni'); ?></strong></label><br>
        <input type="text" name="aavni_tracking_number" id="aavni_tracking_number" value="<?php echo esc_attr($tracking_number); ?>" placeholder="e.g. DL123456789IN" style="width:100%; margin-top:4px;" />
    </p>
    <p>
        <label for="aavni_tracking_url"><strong><?php esc_html_e('Tracking Web URL:', 'aavni'); ?></strong></label><br>
        <input type="url" name="aavni_tracking_url" id="aavni_tracking_url" value="<?php echo esc_attr($tracking_url); ?>" placeholder="https://..." style="width:100%; margin-top:4px;" />
    </p>
    <?php
}

// Save Shipment Meta in WooCommerce HPOS & Standard
add_action('woocommerce_process_shop_order_meta', 'aavni_save_shipment_tracking_meta');
function aavni_save_shipment_tracking_meta($order_id) {
    if (!isset($_POST['aavni_shipment_nonce']) || !wp_verify_nonce($_POST['aavni_shipment_nonce'], 'aavni_save_shipment_meta')) {
        return;
    }
    if (!current_user_can('edit_shop_orders', $order_id)) {
        return;
    }

    $order = wc_get_order($order_id);
    if (!$order) return;

    if (isset($_POST['aavni_order_milestone'])) {
        $old_milestone = $order->get_meta('_aavni_order_milestone');
        $new_milestone = sanitize_text_field($_POST['aavni_order_milestone']);
        $order->update_meta_data('_aavni_order_milestone', $new_milestone);

        // Record in history if changed
        if ($old_milestone !== $new_milestone) {
            $raw_history = $order->get_meta('_aavni_milestone_history');
            $history = is_array($raw_history) ? $raw_history : [];
            $defs = aavni_get_milestone_definitions();
            $title = isset($defs[$new_milestone]) ? $defs[$new_milestone]['label'] : ucfirst($new_milestone);
            $history[] = [
                'milestone' => $new_milestone,
                'title'     => $title,
                'note'      => 'Updated by Store Admin',
                'time'      => current_time('mysql'),
            ];
            $order->update_meta_data('_aavni_milestone_history', $history);

            // Automatically complete order if delivered
            if ($new_milestone === 'delivered' && $order->get_status() !== 'completed') {
                $order->update_status('completed', __('Shipment marked as Delivered by Admin.', 'aavni'));
            }
        }
    }

    if (isset($_POST['aavni_courier_name'])) {
        $order->update_meta_data('_aavni_courier_name', sanitize_text_field($_POST['aavni_courier_name']));
    }
    if (isset($_POST['aavni_tracking_number'])) {
        $order->update_meta_data('_aavni_tracking_number', sanitize_text_field($_POST['aavni_tracking_number']));
    }
    if (isset($_POST['aavni_tracking_url'])) {
        $order->update_meta_data('_aavni_tracking_url', esc_url_raw($_POST['aavni_tracking_url']));
    }

    $order->save();
}

